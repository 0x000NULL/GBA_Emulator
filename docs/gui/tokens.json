  "font": {
    "display": {
      "family": "Archivo",
      "static": "Archivo ExtraCondensed Black",
      "width": 66,
      "weight": 900,
      "case": "upper",
      "lineHeight": 0.9,
      "tracking": 0.3,
      "sizes": {
        "screen": 40,
        "title": 34,
        "hero": 58,
        "cartTitle": 13,
        "headNumber": 30,
        "headTitle": 22
      }
    },
    "interface": {
      "family": "Archivo",
      "static": "Archivo SemiBold / Bold",
      "weight": [
        500,
        600,
        700
      ],
      "sizes": {
        "body": 13,
        "button": 14,
        "emphasis": 15
      }
    },
    "label": {
      "family": "Archivo",
      "static": "Archivo Bold",
      "weight": 700,
      "size": 10.5,
      "tracking": 1.8,
      "case": "upper",
      "color": "fg2"
    },
    "reading": {
      "family": "Source Serif 4",
      "weight": 400,
      "sizes": {
        "body": 13.5,
        "intro": 15
      },
      "lineHeight": 1.45
    },
    "data": {
      "family": "IBM Plex Mono",
      "weight": [
        400,
        500,
        600
      ],
      "sizes": {
        "small": 10.5,
        "body": 12.5,
        "key": 11
      }
    },
    "pixel": {
      "family": "bitmap, Silkscreen-like",
      "glyph": "5x5 caps",
      "advance": 6,
      "lineHeight": 8,
      "case": "upper",
      "note": "own bitmap font in source; see DESIGN.md"
    }
  },
  "layout": {
    "designSize": [
      1280,
      800
    ],
    "minSize": [
      960,
      640
    ],
    "margin": 40,
    "head": {
      "height": 56,
      "rule": 1.5,
      "gap": 14
    },
    "foot": {
      "height": 44,
      "rule": 1,
      "gap": 22
    },
    "gutter": 44,
    "sectionGap": 26
  },
  "component": {
    "key": {
      "height": 22,
      "minWidth": 22,
      "padX": 6,
      "border": 1.5,
      "borderBottom": 3,
      "radius": 3
    },
    "tick": {
      "size": 14,
      "border": 1.5,
      "inset": 2
    },
    "button": {
      "height": 44,
      "padX": 22,
      "outline": 1.5,
      "radius": 0
    },
    "cart": {
      "size": [
        156,
        108
      ],
      "radius": [
        7,
        7,
        3,
        3
      ],
      "grip": {
        "top": 4,
        "inset": 22,
        "height": 11
      },
      "label": {
        "inset": [
          21,
          9,
          9,
          9
        ],
        "radius": 3,
        "artWidth": 52
      },
      "hoverLift": 4,
      "hoverMs": 120
    },
    "film": {
      "frame": [
        240,
        160
      ],
      "frameGap": 12,
      "stripPadX": 12,
      "sprocketBand": 18,
      "hole": [
        12,
        8
      ],
      "holePitch": 30,
      "tilt": [
        -0.4,
        0.3
      ]
    },
    "loupe": {
      "diameter": 250,
      "magnify": 3,
      "ring": 11,
      "rim": 2
    },
    "pencilRing": {
      "stroke": 3.5,
      "color": "spot"
    }
  },
  "pixel": {
    "scale": "integer only; menus are drawn into the 240x160 frame before upscaling",
    "dim": {
      "method": "BLDY-style brightness decrease on a copy of the frame",
      "evy": 9
    },
    "window": {
      "border": [
        {
          "color": "ink",
          "width": 1
        },
        {
          "color": "cream",
          "width": 1
        },
        {
          "color": "shade",
          "width": 1
        }
      ],
      "fill": "cream",
      "padding": 4
    },
    "menu": {
      "itemPitch": 14,
      "cursor": "4x8 right-pointing triangle, red",
      "selectedText": "red"
    },
    "thumb": {
      "size": [
        48,
        32
      ],
      "outline": 1,
      "selectedOutline": "red"
    }
  }
}