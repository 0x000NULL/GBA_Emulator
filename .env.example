# Path to a GBA ROM (.gba or .zip containing one). Never committed.
GBA_ROM=Games/Kingdom Hearts - Chain of Memories (USA).zip
# Optional GBA BIOS dump (16 KiB). If unset, the HLE BIOS is used.
GBA_BIOS=
# Directory holding gba-tests/ (jsmolka) and suite/ (mgba). scripts/fetch-tests.ps1 populates tools/tests.
GBA_TESTS_DIR=tools/tests
